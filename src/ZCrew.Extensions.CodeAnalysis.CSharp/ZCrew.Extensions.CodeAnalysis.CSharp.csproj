<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packaging-only project: produces the ZCrew.Extensions.CodeAnalysis.CSharp package, contains no code -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": the assemblies ship in the package directly, not as dependencies -->
    <ProjectReference Include="../ZCrew.Extensions.CodeAnalysis.CSharp.Abstractions/ZCrew.Extensions.CodeAnalysis.CSharp.Abstractions.csproj" PrivateAssets="all" />
    <!-- Referenced only so the generator assemblies land in $(OutputPath) for the None items below to pack -->
    <ProjectReference Include="../ZCrew.Extensions.CodeAnalysis.CSharp.Embedded/ZCrew.Extensions.CodeAnalysis.CSharp.Embedded.csproj" PrivateAssets="all" />
    <ProjectReference Include="../ZCrew.Extensions.CodeAnalysis.CSharp.IsType/ZCrew.Extensions.CodeAnalysis.CSharp.IsType.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageTags>roslyn;source-generator;code-analysis</PackageTags>
    <Description>Source generator utility library to help embed abstractions and provides common features</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time surface for generator authors -->
    <None Include="$(OutputPath)/ZCrew.Extensions.CodeAnalysis.CSharp.Abstractions.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
    <None Include="$(OutputPath)/ZCrew.Extensions.CodeAnalysis.CSharp.Abstractions.xml" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
    <!-- Loaded by the compiler as analyzers -->
    <None Include="$(OutputPath)/ZCrew.Extensions.CodeAnalysis.CSharp.Embedded.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)/ZCrew.Extensions.CodeAnalysis.CSharp.IsType.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)/ZCrew.Extensions.CodeAnalysis.CSharp.Abstractions.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Imported into projects that reference the package -->
    <None Include="build/ZCrew.Extensions.CodeAnalysis.CSharp.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!-- NuGet package content -->
  <ItemGroup>
    <None Include="../../img/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
